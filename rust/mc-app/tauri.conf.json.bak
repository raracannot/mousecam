{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MouseCam",
  "version": "0.1.0",
  "identifier": "com.mousecam.app",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MouseCam",
        "width": 1200,
        "height": 840,
        "minWidth": 960,
        "minHeight": 660,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}